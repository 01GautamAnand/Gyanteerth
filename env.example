# Public origin used as an SSR SEO fallback.
VITE_PUBLIC_URL=http://localhost:5173

# Optional app ID for the platform's /develop/{id} link.
# SITE_ID=

# Optional cross-origin preview settings.
# FRONTEND_DOMAIN=preview.example.com
# ALLOWED_ORIGINS=https://preview.example.com,https://editor.example.com
# VITE_PARENT_ORIGIN=https://editor.example.com

# Optional contact form API environment. Set either the server URL or host.
# GODADDY_API_BASE_URL=https://api.dev-godaddy.com
# VITE_GODADDY_API_HOST=api.dev-godaddy.com
